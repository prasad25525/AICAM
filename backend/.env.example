# VigilSiddhi settings. install.bat copies this to .env (with a new private key).
# Edit .env, then restart VigilSiddhi (close the two windows and run start.bat again).

# The login. CHANGE THE PASSWORD before using it on a real site.
# (If you change it, also update frontend\.env.development, which pre-fills the login form.)
AICAM_ADMIN_USERNAME=admin
AICAM_ADMIN_PASSWORD=admin123

# Signs login tokens. install.bat replaces this with a random value; keep it private.
AICAM_SECRET_KEY=change-me

# Customer installation for one industry only: uncomment one line to hide the industry tabs.
# AICAM_INDUSTRY_LOCK=cement
# AICAM_INDUSTRY_LOCK=restaurant
